generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTIE
  FINANCIEEL
  SCHADEBEHANDELAAR
  PLANNER
}

model User {
  id           String     @id @default(cuid())
  naam         String
  email        String     @unique
  passwordHash String
  role         Role       @default(SCHADEBEHANDELAAR)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  logs         LogEntry[]
}

model Schade {
  id      String @id @default(cuid())
  nummer  String @unique
  owner   String
  email   String?
  adres   String?
  plaats  String?
  ins     String?
  amount  Int    @default(0)
  profit  Int    @default(0)
  status  String @default("open")
  step    Int    @default(1)
  traject String @default("volledig")

  // Welke haltes gelden voor dit dossier, bijv. [1,3,6,8,9]
  haltes Json   @default("[1,2,3,4,5,6,7,8,9]")
  preset String @default("volledig")

  // Herkomst uit de schadekaart
  opdrachtnummer String?
  opdrachtgever  String?

  // Verzekeraar
  verzStatus       String    @default("geen") // geen | ingediend | akkoord | afgewezen | doorverwezen
  verzSchadenummer String?
  verzEmail        String?
  tussenpersoon    String?
  verzIngediendAt  DateTime?
  afwijzingReden   String?

  // Wachtstand (alleen intern)
  wachtReden String?
  wachtTot   DateTime?

  // Archief
  archived   Boolean   @default(false)
  archivedAt DateTime?

  // Uitvoering
  uitvoeringAt  DateTime?
  gefactureerd  Boolean   @default(false)

  // Financieel — alleen zichtbaar/aanpasbaar voor directie (server dwingt dit af)
  finExpertiseOmzet    Int @default(0)
  finHerstelOmzet      Int @default(0)
  finHerstelInkoop     Int @default(0)
  finHerstelUitbesteed Int @default(0)

  ingediendAt DateTime?
  docVisible  Json      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogEntry {
  id        String   @id @default(cuid())
  text      String
  byUser    User?    @relation(fields: [byUserId], references: [id])
  byUserId  String?
  byName    String
  createdAt DateTime @default(now())
}
